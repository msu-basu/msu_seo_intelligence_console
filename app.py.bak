# ── Quick Stats ───────────────────────────────────────────────────────────────
from pathlib import Path
import pandas as pd, numpy as np

@st.cache_data
def quick_stats():
    p = Path("data/input/01_Blog_GA4.csv")
    if not p.exists():
        return None
    df = pd.read_csv(p, encoding="utf-8-sig")
    agg = df.groupby("Page path and screen class").agg(
        Views=("Views","sum"),
        AU=("Active users","max")
    ).reset_index()
    agg = agg[~agg["Page path and screen class"].isin(["/blog","/blog/","/","(not set)",""])]
    sessions = int((agg["Views"].sum() / 1.18))
    return {
        "articles": len(agg),
        "views": int(agg["Views"].sum()),
        "sessions": sessions,
        "leads": int(sessions * 0.20 * 0.12),
    }

stats = quick_stats()
if stats:
    s1, s2, s3, s4 = st.columns(4)
    s1.markdown(f'<div class="stat-box"><div class="val">{stats["articles"]:,}</div><div class="lbl">Blog Articles</div></div>', unsafe_allow_html=True)
    s2.markdown(f'<div class="stat-box"><div class="val">{stats["views"]:,}</div><div class="lbl">Total Views</div></div>', unsafe_allow_html=True)
    s3.markdown(f'<div class="stat-box"><div class="val">{stats["sessions"]:,}</div><div class="lbl">Est. Sessions</div></div>', unsafe_allow_html=True)
    s4.markdown(f'<div class="stat-box"><div class="val">{stats["leads"]:,}</div><div class="lbl">Est. Leads</div></div>', unsafe_allow_html=True)

st.markdown("---")

