# =============================================================================
# MSU WEBSITE SEO & CONTENT INTELLIGENCE CONSOLE
# Environment Configuration (.env)
# =============================================================================

# --- Google Cloud & API Authentication ---
# Path to your downloaded Service Account JSON key (relative or absolute)
GOOGLE_APPLICATION_CREDENTIALS=credentials/google_service_account.json

# Your GA4 Property ID (numeric only, found in GA4 Admin -> Property Settings)
GA4_PROPERTY_ID=123456789

# Your GSC Site URL (e.g., https://www.msu.edu.in/ or sc-domain:msu.edu.in)
GSC_SITE_URL=https://www.msu.edu.in/

# --- PostgreSQL Analytical Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=web_analytics
DB_USER=postgres
DB_PASSWORD=123

# --- AI Assistant Configuration (Optional) ---
# Supported providers: gemini, openai, groq, ollama, local
# Note: If no API key is provided, the chatbot automatically uses the built-in
# Local Zero-Key Analytical Engine to query PostgreSQL directly.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# Google Gemini API Key (get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (optional alternative)
OPENAI_API_KEY=

# Groq API Key (optional alternative for ultra-fast Llama)
GROQ_API_KEY=

# Ollama Base URL (if using local Ollama instance)
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Ingestion Pipeline Settings ---
PIPELINE_LOOKBACK_DAYS=3
PIPELINE_LOG_LEVEL=INFO
